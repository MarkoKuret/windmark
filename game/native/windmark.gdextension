[configuration]

entry_symbol = "windmark_library_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]

macos.debug.arm64 = "res://bin/libwindmark_godot.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libwindmark_godot.macos.template_release.arm64.dylib"
linux.debug.x86_64 = "res://bin/libwindmark_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libwindmark_godot.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libwindmark_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libwindmark_godot.windows.template_release.x86_64.dll"
