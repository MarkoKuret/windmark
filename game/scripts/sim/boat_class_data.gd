class_name BoatClassData
extends RefCounted
## Loads a class for the front end: the class file (data/classes/<id>.boat.json), its generated performance file
## (data/perf/<id>.perf.json) and the boatgen physics sidecar (game/generated/boats/<id>.physics.json, optional).
## Read only: these files are generated by our tools and never written here.

var info: SimSource.ClassInfo
var perf := {}
## sail index by sail name
var sail_index := {}
## per config: key -1 = main only, else the front sail index -> {polar, heel, accel, trim_speed, trim_heel,
## optimal: {sail index: PerfTable}}
var configs := {}
## per sail index: {shiver_angle, sheet_max_by_heel, pole_angle, pole_rate, rate_in, rate_out, shiver_free,
## handling: {prepare_hoist_time, ...: PerfTable}, slow: {phase: s}}
var sail_data := {}
var dyn := {}
## dynamics tables by name (null when absent)
var tables := {}
var start_front := -1


static func repo_path(rel: String) -> String:
	return ProjectSettings.globalize_path("res://").path_join("..").path_join(rel).simplify_path()


static func _read_json(path: String) -> Variant:
	if not FileAccess.file_exists(path):
		return null
	var text := FileAccess.get_file_as_string(path)
	return JSON.parse_string(text)


static func load_class(id: String) -> BoatClassData:
	var cls: Variant = _read_json(repo_path("data/classes/%s.boat.json" % id))
	var perf_d: Variant = _read_json(repo_path("data/perf/%s.perf.json" % id))
	if cls == null or perf_d == null:
		push_error("class %s: class or perf file missing" % id)
		return null
	var side: Variant = _read_json(ProjectSettings.globalize_path("res://generated/boats/%s.physics.json" % id))
	var d := BoatClassData.new()
	d._build(cls, perf_d, side if side != null else {})
	return d


func _build(cls: Dictionary, perf_d: Dictionary, side: Dictionary) -> void:
	perf = perf_d
	info = SimSource.ClassInfo.new()
	info.id = cls["id"]
	info.name = cls.get("name", info.id)
	info.loa = float(cls["hull"]["loa"])
	info.beam_max = float(cls["hull"]["beam_max"])
	var dy: Dictionary = perf_d.get("dynamics", {})
	info.lwl = float(dy.get("lwl", cls["hull"].get("lwl", 0.9 * info.loa)))
	info.bwl = float(dy.get("bwl", cls["hull"].get("bwl", 0.75 * info.beam_max)))
	info.transom_width = float(cls["hull"].get("transom_width", 0.6 * info.bwl))
	info.rudder_max = float(dy.get("rudder_max", 0.6))
	info.steering = cls.get("visual", {}).get("deck", {}).get("steering", "tiller")
	info.physics = side
	var i := 0
	for name in perf_d["sails"]:
		var s: Dictionary = perf_d["sails"][name]
		var si := SimSource.SailInfo.new()
		si.name = name
		si.type = s["type"]
		si.sheet_min = float(s["sheet_min"])
		si.sheet_max = float(s["sheet_max"])
		info.sails.append(si)
		sail_index[name] = i
		if si.type == "main":
			info.main_sail = i
		else:
			info.front_sails.append(i)
		var sd := {
			"rate_in": float(s["rate_in"]), "rate_out": float(s["rate_out"]),
			"shiver_free": bool(s.get("shiver_free", false)),
			"shiver_angle": PerfTable.from_json(s.get("shiver_angle")),
			"sheet_max_by_heel": PerfTable.from_json(s.get("sheet_max_by_heel")),
			"pole_angle": PerfTable.from_json(s.get("pole_angle")),
			"pole_rate": float(s.get("pole_rate", 0.0)),
			"handling": {}, "slow": {},
		}
		var hd: Dictionary = s.get("handling", {})
		for k in ["prepare_hoist_time", "hoist_time", "prepare_drop_time", "drop_time"]:
			sd["handling"][k] = PerfTable.constant_or_table(hd.get(k, 0.0))
		sd["slow"] = {
			SimSource.Phase.PREPARE_HOIST: float(hd.get("slow_prepare_hoist", 1.0)),
			SimSource.Phase.HOISTING: float(hd.get("slow_hoist", 1.0)),
			SimSource.Phase.PREPARE_DROP: float(hd.get("slow_prepare_drop", 1.0)),
			SimSource.Phase.DROPPING: float(hd.get("slow_drop", 1.0)),
		}
		sail_data[i] = sd
		i += 1
	for c in perf_d["configs"]:
		var key := -1 if c["front_sail"] == null else int(sail_index[c["front_sail"]])
		var opt := {}
		for sname in c.get("optimal_angle", {}):
			opt[sail_index[sname]] = PerfTable.from_json(c["optimal_angle"][sname])
		configs[key] = {
			"polar": PerfTable.from_json(c["polar"]), "heel": PerfTable.from_json(c["heel"]),
			"accel": PerfTable.from_json(c["accel"]), "trim_speed": PerfTable.from_json(c.get("trim_speed")),
			"trim_heel": PerfTable.from_json(c.get("trim_heel")), "optimal": opt,
			"fall_off": PerfTable.from_json(c.get("fall_off")),
		}
	dyn = perf_d["dynamics"]
	for k in ["heel_speed_factor", "rudder_drag_luff", "rudder_drag_bear"]:
		tables[k] = PerfTable.from_json(dyn.get(k))
	var sf: Variant = perf_d.get("start", {}).get("front_sail")
	start_front = -1 if sf == null else int(sail_index.get(sf, -1))
